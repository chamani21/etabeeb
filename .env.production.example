# ──────────────────────────────────────────────────────────────────────────────
# eTabeeb Production Environment Variables
# Copy this file to .env.production on the VPS and fill in all values.
# NEVER commit .env.production to Git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_PATH=/etabeeb
IMAGE_TAG=latest

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# NEXTAUTH_URL must match the production canonical URL exactly
NEXTAUTH_URL=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Use the existing VPS PostgreSQL. Do NOT create a new container for it.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# ── LiveKit (Video Calls) ─────────────────────────────────────────────────────
# Leave blank to run in demo mode (no real video)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@etabeeb.online

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/private-uploads
# Max upload size in bytes (default 10 MB)
UPLOAD_MAX_BYTES=10485760
