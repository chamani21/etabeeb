{
  "name": "etabeeb",
  "version": "0.1.0",
  "private": true,
  "description": "eTabeeb telemedicine platform — Kozhak Specialist Clinic",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "turbo run db:push --filter=@etabeeb/db",
    "db:migrate": "turbo run db:migrate --filter=@etabeeb/db",
    "db:studio": "turbo run db:studio --filter=@etabeeb/db"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "@types/node": "^22.5.5",
    "prettier": "^3.3.3",
    "eslint": "^9.10.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.19.0"
}
