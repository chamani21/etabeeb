# =============================================================================
# eTabeeb Environment Variable Manifest
# PURPOSE: Names, purposes, owners, and validation rules ONLY.
# WARNING: NEVER paste real values here. Copy this file to .env.local and
#          populate with real values through a secure secrets manager.
# =============================================================================

# --- DATABASE ---
# Owner: DevOps / Admin
# Validation: Must be valid PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/etabeeb"

# Separate read replica (optional, falls back to DATABASE_URL)
DATABASE_READ_URL="postgresql://USER:PASSWORD@HOST:5432/etabeeb"

# --- AUTHENTICATION ---
# Owner: Admin
# Validation: >= 64 random bytes, base64url encoded. Run: openssl rand -base64 64
NEXTAUTH_SECRET="REPLACE_WITH_64_BYTE_RANDOM_SECRET"

# Canonical app URL (no trailing slash)
# Staging: https://staging.etabeeb.online
# Production: https://etabeeb.online
NEXTAUTH_URL="https://staging.etabeeb.online"

# OTP expiry in seconds (default: 300 = 5 min)
OTP_EXPIRY_SECONDS="300"

# OTP max attempts per number per window (brute-force protection)
OTP_MAX_ATTEMPTS="5"

# OTP rate-limit window in seconds (default: 3600 = 1 hour)
OTP_RATE_WINDOW_SECONDS="3600"

# --- WHATSAPP CLOUD API ---
# Owner: Clinic Administrator (WhatsApp Business account holder)
# Validation: All three values required for WhatsApp to work.
# DO NOT paste token values here. Use secrets manager or environment injection.
WHATSAPP_PHONE_NUMBER_ID="REPLACE_WITH_PHONE_NUMBER_ID"
WHATSAPP_WABA_ID="REPLACE_WITH_WABA_ID"
WHATSAPP_ACCESS_TOKEN="REPLACE_WITH_SYSTEM_USER_TOKEN"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="REPLACE_WITH_RANDOM_WEBHOOK_VERIFY_TOKEN"

# --- eTABIB V1 / n8n INTEGRATION ---
# Owner: Admin / DevOps. Values are random secrets — never commit real values.
# n8n → app: shared key n8n sends in the `x-etabib-key` header to /api/hooks/*
# Generate: openssl rand -base64 48
ETABIB_HOOK_KEY="REPLACE_WITH_RANDOM_SHARED_KEY"
# app → n8n: "eTabib - Outbound Sender" webhook URL, and the key the app sends
# in the `x-etabib-key` header. Leave empty to keep outbound jobs queued.
ETABIB_N8N_OUTBOUND_URL="https://n8n.example.com/webhook/REPLACE_WITH_OUTBOUND_SENDER_PATH"
ETABIB_N8N_OUTBOUND_KEY="REPLACE_WITH_RANDOM_SHARED_KEY"
# Staff WhatsApp numbers (E.164) the app resolves for admin/doctor notifications
ETABIB_ADMIN_WHATSAPP="REPLACE_WITH_ADMIN_E164_NUMBER"
ETABIB_DOCTOR_WHATSAPP="REPLACE_WITH_DOCTOR_E164_NUMBER"
# Meta app secret: verifies X-Hub-Signature-256 on forwarded webhooks (REQUIRED in production)
ETABIB_META_APP_SECRET="REPLACE_WITH_META_APP_SECRET"
# Meta webhook verification token (GET hub.verify_token), checked by the app, not by n8n
ETABIB_META_VERIFY_TOKEN="REPLACE_WITH_RANDOM_VERIFY_TOKEN"
# users.id (UUID) of the fixed V1 doctor (Dr. Jalaluddin). Doctor routes fail closed if unset.
ETABIB_V1_DOCTOR_USER_ID="REPLACE_WITH_DOCTOR_USER_UUID"
# P1 inbound control (backend-enforced, independent of n8n). Kill switch defaults to OFF:
# anything other than "true" means no case is created and nothing is sent.
ETABIB_WHATSAPP_INBOUND_ENABLED="false"
# disabled | allowlist | public  (unset → allowlist; unrecognised → disabled). Never "public" before go-live review.
ETABIB_INBOUND_MODE="allowlist"
# APPROVED WhatsApp templates only (see docs/ETABIB_V1_WHATSAPP_TEMPLATES.md). Unlisted intents use text.
# ETABIB_WA_TEMPLATES='{"DOCTOR_APPROVAL_REQUEST":{"name":"etabib_doctor_approval_v1","language":"en"}}'
# Display labels for the admin status page (non-secret)
ETABIB_ENVIRONMENT="staging"
ETABIB_WHATSAPP_DISPLAY_NUMBER="REPLACE_WITH_DISPLAY_NUMBER"
# Tests only: DISPOSABLE database (name must contain "test"); it is wiped on every test run.
# ETABIB_TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/etabeeb_test"

# --- VIDEO / LIVEKIT (Phase 6.6: one room per consultation case) ---
# Owner: DevOps. Video fails closed (patients see "not available") until all three are set.
LIVEKIT_URL="wss://REPLACE_WITH_PROJECT.livekit.cloud"
LIVEKIT_API_KEY="REPLACE_WITH_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="REPLACE_WITH_LIVEKIT_API_SECRET"
# Join windows (minutes) and absolute patient-link lifetime after the scheduled time (hours)
ETABIB_VIDEO_JOIN_EARLY_MINUTES="15"
ETABIB_VIDEO_JOIN_LATE_MINUTES="120"
ETABIB_VIDEO_DOCTOR_EARLY_MINUTES="60"
ETABIB_VIDEO_LINK_TTL_HOURS="24"

# --- OBJECT STORAGE ---
# Owner: DevOps
# Validation: S3-compatible endpoint. NEVER use public bucket.
STORAGE_ENDPOINT="https://s3.example.com"
STORAGE_BUCKET="etabeeb-private-uploads"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY="REPLACE_WITH_ACCESS_KEY"
STORAGE_SECRET_KEY="REPLACE_WITH_SECRET_KEY"
# Signed URL expiry in seconds (default: 900 = 15 min)
STORAGE_SIGNED_URL_EXPIRY="900"

# --- PDF GENERATION ---
# Owner: DevOps
# Chromium/Puppeteer path for prescription PDF rendering
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"

# --- MALWARE SCANNING ---
# Owner: DevOps
# ClamAV socket or REST endpoint (optional — uploads quarantined until cleared)
CLAMAV_SOCKET="/var/run/clamav/clamd.sock"

# --- EMAIL ---
# Owner: DevOps / Admin
# SMTP for transactional email (fallback for WhatsApp failures)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@etabeeb.online"
SMTP_PASSWORD="REPLACE_WITH_SMTP_PASSWORD"
SMTP_FROM="ای طبیب <noreply@etabeeb.online>"

# --- ENCRYPTION ---
# Owner: Admin
# 32-byte AES-256 key for encrypting sensitive fields at rest
# Generate: openssl rand -hex 32
FIELD_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_HEX_KEY"

# --- APPLICATION ---
NODE_ENV="staging"
NEXT_PUBLIC_APP_URL="https://staging.etabeeb.online"
NEXT_PUBLIC_APP_NAME="eTabeeb"
NEXT_PUBLIC_WHATSAPP_DISPLAY_NUMBER="0333 2357055"

# Feature flags (true/false)
FEATURE_VIDEO_ENABLED="true"
FEATURE_MANUAL_PAYMENT_ADMIN_BYPASS="true"
FEATURE_GATEWAY_PAYMENT_ENABLED="false"
FEATURE_RECORDING_ENABLED="false"
FEATURE_AI_DRAFT_ASSIST="false"

# --- MONITORING ---
# Owner: DevOps
SENTRY_DSN="REPLACE_WITH_SENTRY_DSN"
SENTRY_ENVIRONMENT="staging"
